{
  "data": {
    "dataset_name": "vietgpt/wikipedia_vi",
    "dataset_split": "train",
    "text_column": "text",
    "sequence_length": 512,
    "validation_fraction": 0.02,
    "max_samples": 50000,
    "tokenizer_vocab_size": 16000,
    "tokenizer_dir": "artifacts/raikiri/tokenizer",
    "seed": 42
  },
  "model": {
    "name": "raikiri",
    "architecture_repo": "internlm/Intern-S2-Mobius",
    "architecture_revision": "1b23c974ac860b182c61732299ae4fc432a8cf54",
    "hidden_size": 384,
    "num_hidden_layers": 8,
    "num_attention_heads": 6,
    "num_key_value_heads": 2,
    "head_dim": 64,
    "num_memory_blocks": 2,
    "num_memory_experts": 32,
    "experts_per_token": 2,
    "expert_intermediate_size": 128,
    "local_expert_intermediate_size": 768,
    "full_attention_every": 4,
    "sliding_window": 256,
    "attention_backend": "auto"
  },
  "train": {
    "output_dir": "artifacts/raikiri/checkpoints",
    "num_train_epochs": 1.0,
    "learning_rate": 0.0003,
    "weight_decay": 0.1,
    "warmup_ratio": 0.03,
    "per_device_train_batch_size": 4,
    "per_device_eval_batch_size": 4,
    "gradient_accumulation_steps": 8,
    "logging_steps": 10,
    "eval_steps": 250,
    "save_steps": 250,
    "save_total_limit": 2,
    "fp16": true,
    "bf16": false,
    "gradient_checkpointing": true,
    "seed": 42
  }
}
