# Non-secret Docker Compose settings for Raikiri (ADR 0005). Use with:
#   docker compose --env-file compose.raikiri.env -f compose.raikiri.yaml up --build -d
# Variables set in the shell override these values. Secrets never go here.

# Host side
RAIKIRI_HOST_DATASET_DIR=./dataset
RAIKIRI_HOST_ARTIFACT_DIR=./artifacts/raikiri
RAIKIRI_HOST_TB_BIND=127.0.0.1
RAIKIRI_HOST_TB_PORT=6006

# Overrides projects/raikiri/config.json inside the container: train from the mounted dataset.
RAIKIRI_DATA_DATASET_NAME=/datasets
